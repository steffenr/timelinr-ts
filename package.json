{
  "name": "timelinr",
  "version": "1.0.0",
  "description": "Framework-agnostic timeline slider. Modern TypeScript rebuild of jQuery Timelinr.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/timelinr.js",
  "module": "./dist/timelinr.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/timelinr.js"
    },
    "./styles/timelinr.css": "./dist/timelinr.css"
  },
  "files": [
    "dist",
    "styles"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:examples",
    "build:lib": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly && node scripts/build-css.mjs",
    "build:examples": "node scripts/build-examples.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "happy-dom": "^18.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.11",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
