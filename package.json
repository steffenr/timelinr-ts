{
  "name": "timelinr-ts",
  "version": "1.2.0",
  "description": "Framework-agnostic timeline slider. Modern TypeScript rebuild of jQuery Timelinr.",
  "type": "module",
  "license": "MIT",
  "author": "Steffen Rühlmann (https://github.com/steffenr)",
  "homepage": "https://github.com/steffenr/timelinr-ts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/steffenr/timelinr-ts.git"
  },
  "bugs": {
    "url": "https://github.com/steffenr/timelinr-ts/issues"
  },
  "keywords": [
    "timeline",
    "slider",
    "carousel",
    "typescript",
    "framework-agnostic",
    "zero-dependency",
    "accessible"
  ],
  "main": "./dist/timelinr.element.js",
  "module": "./dist/timelinr.element.js",
  "types": "./dist/element.d.ts",
  "exports": {
    ".": {
      "types": "./dist/element.d.ts",
      "import": "./dist/timelinr.element.js"
    },
    "./styles/timelinr.css": "./dist/timelinr.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/timelinr.element.js",
    "./src/element.ts"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:examples",
    "build:lib": "tsc -p tsconfig.build.json --emitDeclarationOnly && node scripts/build-element.mjs && node scripts/build-css.mjs",
    "build:examples": "node scripts/build-examples.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm test && npm run typecheck && npm run build:lib"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "happy-dom": "^20.11.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.11",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
